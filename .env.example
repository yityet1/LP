# 多策略套利系统环境变量模板 (.env.example)
# 注意：生产环境密钥必须通过 Secret Manager 注入，严禁将真实密钥写入代码库！

APP_ENV=paper
LOG_LEVEL=INFO
RISK_POLICY_PATH=configs/risk-policy.example.yaml
LEDGER_DB_URL=sqlite:///:memory:

# 硬性安全门禁：默认必须为 false
LIVE_TRADING_ENABLED=false
LIVE_APPROVAL_TICKET_ID=

# Binance Spot / USD-M Credentials (Read-only / Paper by default)
BINANCE_API_KEY=your_binance_api_key_placeholder
BINANCE_API_SECRET=your_binance_api_secret_placeholder

# OKX V5 Credentials (Second CEX selected in META-001)
OKX_API_KEY=your_okx_api_key_placeholder
OKX_API_SECRET=your_okx_api_secret_placeholder
OKX_PASSPHRASE=your_okx_passphrase_placeholder
